+  /* DXMT_FRAMETIME_LOG=<windows path>: append the time between Present calls (ms, one per line)
+   * for offline benchmarking (tools/ow-bench.py). */
+  static void LogFrameTime() {
+    static FILE *file = [] {
+      auto path = env::getEnvVar("DXMT_FRAMETIME_LOG");
+      FILE *f = path.empty() ? nullptr : fopen(path.c_str(), "a");
+      if (f)
+        setvbuf(f, nullptr, _IOFBF, 1 << 16);
+      return f;
+    }();
+    static LARGE_INTEGER freq, last;
+    static uint32_t frames;
+    if (!file)
+      return;
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    if (!freq.QuadPart)
+      QueryPerformanceFrequency(&freq);
+    else
+      fprintf(file, "%.3f\n", (now.QuadPart - last.QuadPart) * 1000.0 / freq.QuadPart);
+    last = now;
+    if (++frames % 240 == 0)
+      fflush(file);
+  }
